    {
      "parameters": {
        "jsCode": "let fullText = \"\";\nconst items = $input.all();\nconst MAX_ROWS = 5000;\n\n// Track statistics\nconst stats = {\n  GitHub: 0,\n  Positions: 0,\n  Connections: 0,\n  Skills: 0,\n  Education: 0,\n  Profile: 0,\n  Unknown: 0\n};\n\nif (items.length > 0) {\n  let currentSection = \"\";\n  \n  for (let i = 0; i < items.length && i < MAX_ROWS; i++) {\n    const row = items[i].json;\n    let sectionHeader = \"\";\n    \n    // identify source type\n    if (row.html_url && row.full_name) {\n       stats.GitHub++;\n       sectionHeader = \"GITHUB_REPO\";\n    } else if (row['Company Name'] !== undefined) {\n       stats.Positions++;\n       sectionHeader = \"POSITION\";\n    } else if (row['First Name'] !== undefined && row['Connected On'] !== undefined) {\n       stats.Connections++;\n       sectionHeader = \"CONNECTION\";\n    } else if (row['Skill Name'] !== undefined) {\n       stats.Skills++;\n       sectionHeader = \"SKILL\";\n    } else if (row['School Name'] !== undefined) {\n       stats.Education++;\n       sectionHeader = \"EDUCATION\";\n    } else if (row['Headline'] !== undefined || row['Summary'] !== undefined) {\n       stats.Profile++;\n       sectionHeader = \"PROFILE\";\n    } else {\n       stats.Unknown++;\n       sectionHeader = \"UNKNOWN_DATA\";\n    }\n\n    const rowString = Object.entries(row)\n      .filter(([key, value]) => value !== '' && value !== null)\n      .map(([key, value]) => `${key}: ${value}`)\n      .join(' | ');\n      \n    if (rowString.length > 0) {\n      fullText += `[${sectionHeader}] ${rowString}\\n`;\n    }\n  }\n  \n  // Prepend summary\n  let summary = \"### INPUT DATA SUMMARY:\\n\";\n  for (const [key, count] of Object.entries(stats)) {\n    if (count > 0) summary += `- ${key}: ${count} rows\\n`;\n  }\n  summary += \"\\n### RAW DATA START:\\n\";\n  fullText = summary + fullText;\n  \n} else {\n  fullText = \"No data found in the processed CSV files.\";\n}\n\nreturn [{\n  json: {\n    text_context: fullText\n  }\n}];"
      },
      "id": "merger-code",
      "name": "Data Merger",
      "position": [
        1856,
        304
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key=AIzaSyCT5pLRHy7mFuzTVSuRCF8UIBF7EpKFQtM",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ \n  {\n    \"contents\": [\n      {\n        \"parts\": [\n          {\n            \"text\": \"You are an elite LinkedIn Profile Strategist.\\n\\nYour goal is to audit the user's data and generate a strategic intelligence report.\\n\\n### CRITICAL INSTRUCTION: HANDLING MISSING DATA\\nLinkedIn data exports are often sparse (e.g., missing descriptions).\\n- IF DESCRIPTIONS ARE MISSING: Do NOT just say data missing. Instead, infer potential duties/impact based on Job Title and Company Name. Example: If title is Senior Data Analyst, assume they handled SQL pipelines and reporting, and suggest they HIGHLIGHT those.\\n- Label your advice as [Generated Insight] when inferring.\\n\\n### Input Data Format\\nThe input data starts with a SUMMARY showing row counts per section (Positions, Skills, Connections, etc). Use this to understand available data.\\nRows are labeled like [POSITION] Title: ... | Company: ... or [SKILL] Skill Name: ...\\n\\n### REPORT STRUCTURE\\n\\n#### PART 1: The Red Flag Audit\\n1. Positions Analysis: Analyze each job title vs duration. For each role without a description, list 3 high-impact bullet point keywords they SHOULD add.\\n2. Skills Audit: Group skills by category (Tech, Soft Skills, Tools). Suggest 5 modern skills missing from their profile based on their recent roles.\\n3. Profile Optimization: Based on their most recent role and skills, write a suggested LinkedIn Headline (max 120 chars).\\n\\n#### PART 2: The Action Plan\\n1. Content Strategy: Suggest 3 specific LinkedIn post ideas based on their skills or roles.\\n2. Network Strategy: Based on their industry and connection data, advise on who to connect with next.\\n3. GitHub Synergy: If GitHub repos are present, suggest which projects to feature on LinkedIn and how to describe them.\\n\\nFormat your entire response in clean Markdown with headers and bullet points.\\n\\n--- USER DATA START ---\\n\\n\" + $json.text_context\n          }\n        ]\n      }\n    ],\n    \"generationConfig\": {\n      \"temperature\": 0.7,\n      \"maxOutputTokens\": 4000\n    }\n  }\n}}",
        "options": {}
      },
      "id": "groq-analysis",
      "name": "AI Analysis (Gemini)",
      "position": [
        2064,
        304
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const markdown = $input.item.json.candidates[0].content.parts[0].text;\n\nlet html = markdown\n  .replace(/^### (.*$)/gim, '<h3>$1</h3>')\n  .replace(/^## (.*$)/gim, '<h2>$1</h2>')\n  .replace(/^# (.*$)/gim, '<h1>$1</h1>')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n  .replace(/\\*(.*?)\\*/g, '<em>$1</em>')\n  .replace(/\\n/g, '<br>');\n\nreturn [{\n  json: {\n    html: html,\n    original: markdown\n  }\n}];"
      },
      "id": "markdown-to-html",
      "name": "Convert to HTML",
      "position": [
        2256,
        304
